--- /dev/null
+++ b/runtime/bin/rdd_test_loopback.h
@@ -0,0 +1,37 @@
+// Task-owned loopback test boundary. Not a native-plugin/process sandbox.
+#ifndef RDD_TEST_LOOPBACK_H_
+#define RDD_TEST_LOOPBACK_H_
+#include <arpa/inet.h>
+#include <errno.h>
+#include <string.h>
+#include <sys/socket.h>
+#if defined(RDD_TEST_LOOPBACK_ONLY)
+namespace dart { namespace bin {
+inline bool RddLocalAddress(const struct sockaddr* address) {
+  if (!address) return false;
+  if (address->sa_family == AF_INET) {
+    return (ntohl(reinterpret_cast<const sockaddr_in*>(address)->sin_addr.s_addr) >> 24) == 127;
+  }
+  if (address->sa_family == AF_INET6) {
+    const auto* a = reinterpret_cast<const sockaddr_in6*>(address);
+    return IN6_IS_ADDR_LOOPBACK(&a->sin6_addr) && a->sin6_scope_id == 0;
+  }
+  return false;
+}
+inline bool RddRequireLocal(const struct sockaddr* address) {
+  if (RddLocalAddress(address)) return true;
+  errno = EACCES;
+  return false;
+}
+inline const char* RddNumericLocalHost(const char* host) {
+  if (!host) return nullptr;
+  if (strcmp(host, "localhost") == 0) return "127.0.0.1";
+  sockaddr_in a4 = {}; a4.sin_family = AF_INET;
+  if (inet_pton(AF_INET, host, &a4.sin_addr) == 1 && RddLocalAddress(reinterpret_cast<sockaddr*>(&a4))) return host;
+  sockaddr_in6 a6 = {}; a6.sin6_family = AF_INET6;
+  if (inet_pton(AF_INET6, host, &a6.sin6_addr) == 1 && RddLocalAddress(reinterpret_cast<sockaddr*>(&a6))) return host;
+  return nullptr;
+}
+} }
+#endif
+#endif
